// Solana Meme Coin Holder Tracker & Anti-Scam Dashboard
//
// This schema mirrors the REAL tables already in production in your Neon
// project (introspected 2026-08-09, then copied read-only into this app's
// database — see migration notes in README.md). It intentionally does NOT
// match the 5-table design from the first pass of this scaffold: that was
// a guess made before I could see your actual data, and your actual data
// is better than the guess (`coin_stats.outcome` is real curated ground
// truth — dumped / pumped / pump_and_dump — which beats the peak-mcap
// heuristic the first draft invented).
//
// TaggedWallet and CoinStat below are exact matches to the live schema:
// same table/column names, types, and the existing single-tag-per-address
// design (address is the primary key — one tag applies globally to a
// wallet, not per-token). HolderSnapshot is the one genuinely new table:
// it backs live-scan history and Time-Travel mode caching and doesn't
// exist in your original two-table dataset.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Matches the real `tagged_wallets` table. `tag` is a free-text varchar
/// in production (not a DB enum) — currently only 'insider' and 'outsider'
/// appear in your data, with 'mev_bot' reserved for the UI's third toggle.
/// Validation of allowed values happens in the app layer (src/types), not
/// the DB, to avoid an unrequested migration on your live table.
model TaggedWallet {
  address       String  @id @db.VarChar(64)
  tag           String  @db.VarChar(32)
  label         String? @db.VarChar(255)
  notes         String?
  tokenMint     String? @map("token_mint") @db.VarChar(64)
  clusterParent String? @map("cluster_parent") @db.VarChar(64)
  createdAt     BigInt? @map("created_at")
  updatedAt     BigInt? @map("updated_at")
  note          String?

  @@index([clusterParent])
  @@index([label])
  @@map("tagged_wallets")
}

/// Matches the real `coin_stats` table — one row per tracked launch, with
/// `outcome` as the curated ground truth for the pump-vs-dump question
/// this whole project is built around, and `wallet_group` as the
/// human-readable cluster key (joins to TaggedWallet.label by value, e.g.
/// both containing "Pochi Bin 30" — there's no formal FK in the source
/// data, so this is a value-match join, not a relational one).
model CoinStat {
  mint             String   @id
  name             String?
  symbol           String?
  walletGroup      String?  @map("wallet_group")
  outcome          String? // 'dumped' | 'pumped' | 'pump_and_dump' (free text in source)
  marketCapUsd     Float?   @map("market_cap_usd")
  maxMarketCapUsd  Float?   @map("max_market_cap_usd")
  durationMinutes  Int?     @map("duration_minutes")
  insiderCount     Int?     @map("insider_count")
  insiderPercent   Float?   @map("insider_percent")
  insiderSol       Float?   @map("insider_sol")
  outsiderCount    Int?     @map("outsider_count")
  outsiderPercent  Float?   @map("outsider_percent")
  lpSol            Float?   @map("lp_sol")
  lpPercent        Float?   @map("lp_percent")
  holderCount      Int?     @map("holder_count")
  priceUsd         Float?   @map("price_usd")
  liquiditySol     Float?   @map("liquidity_sol")
  totalSupply      Float?   @map("total_supply")
  devAddress       String?  @map("dev_address")
  isPumpFun        Boolean? @map("is_pump_fun")
  notes            String?
  snapshotAt       BigInt?  @map("snapshot_at")
  createdAt        BigInt?  @map("created_at")
  updatedAt        BigInt?  @map("updated_at")
  logoUri          String?  @map("logo_uri")

  @@index([walletGroup])
  @@index([devAddress])
  @@map("coin_stats")
}

/// NEW table (not part of your original dataset): point-in-time holder
/// table captures. Backs both live-scan history (outsider-inflow trend
/// detection) and the Time-Travel mode cache. `walletAddress` is a value
/// link to TaggedWallet.address, NOT a DB foreign key — most current
/// holders on any given scan won't be tagged yet, and a FK constraint
/// would reject inserting those rows. Same reasoning for `mintAddress`
/// against CoinStat.mint: a freshly-scanned mint may not have a coin_stats
/// row (yet, or ever, if you never log an outcome for it).
model HolderSnapshot {
  id            String @id @default(cuid())
  mintAddress   String @map("mint_address") @db.VarChar(64)
  walletAddress String @map("wallet_address") @db.VarChar(64)

  balanceRaw      Decimal @map("balance_raw") @db.Decimal(38, 0)
  percentOfSupply Float   @map("percent_of_supply")
  solInPool       Float?  @map("sol_in_pool")
  marketCapUsd    Float?  @map("market_cap_usd")

  slot       BigInt
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  @@index([mintAddress, capturedAt])
  @@index([mintAddress, slot])
  @@index([walletAddress])
  @@map("holder_snapshots")
}
