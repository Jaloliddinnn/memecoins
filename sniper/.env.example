# ---------------------------------------------------------------------------
# WALLET — a burner. Fund it with what you are willing to lose today, nothing
# more. Never put a wallet here that holds anything else.
# ---------------------------------------------------------------------------
PRIVATE_KEY="base58-or-[1,2,3...]-json-array"

# ---------------------------------------------------------------------------
# TARGETS — the scammer wallets that open the block-0 stack with ~20 SOL.
# These rotate every few coins. Feed them from your tracker, do not hand-edit.
# ---------------------------------------------------------------------------
TARGET_WALLETS="wallet1,wallet2,wallet3,wallet4"
MIN_TARGET_SOL="10"

# ---------------------------------------------------------------------------
# FEED — this is the one that decides whether the bot makes or loses money.
# A plain RPC websocket hands you the block AFTER it is built, so you fire one
# slot late, which costs ~13.5% of an ~18% move. You need a gRPC/Geyser stream
# at PROCESSED commitment or better.
#   Chainstack Yellowstone   from $49/mo
#   rpc edge Trader          from $249/mo
#   Shyft                    $199 / $349 / $649
#   Helius LaserStream       $499/mo (own SDK, not Yellowstone-compatible)
# ---------------------------------------------------------------------------
RPC_URL="https://your-rpc-endpoint"
GRPC_URL="https://your-yellowstone-endpoint:443"
GRPC_TOKEN=""

# ---------------------------------------------------------------------------
# RELAYS — the express lanes. Send to all of them at once; duplicates are
# dropped by the network, so there is no downside to fanning out.
# Get the CURRENT tip accounts from each provider's docs — they change.
# ---------------------------------------------------------------------------
NOZOMI_URL=""
NOZOMI_TIP=""
ASTRALANE_URL=""
ASTRALANE_TIP=""

# ---------------------------------------------------------------------------
# SIZE AND FEES
#
# Measured competition per buy, 2026-09-07:
#   41Lur83...C3od  0.0500 fee + 0.0513 tip  ->   0% failures
#   HyMGBFBi...     0.0460 fee + 0.0247 tip  ->  25% failures
#   5hQ38HKk...     0.0002 fee + 0.0047 tip  ->  59% failures
#   FEUa5TK...Hz4   0.0000 fee + 0.0047 tip  ->  92% failures
#
# At CU_LIMIT 250000, CU_PRICE 240000 micro-lamports = 0.06 SOL priority fee.
# With TIP_SOL 0.055 that is ~0.115 SOL/attempt — above the best of them.
# ---------------------------------------------------------------------------
BUY_SOL="2.0"
CU_LIMIT="250000"
CU_PRICE="240000"
TIP_SOL="0.055"
MAX_SOL_MULTIPLIER="1.35"

# ---------------------------------------------------------------------------
# RISK
# ---------------------------------------------------------------------------
HOLD_SECONDS="20"
MAX_CONCURRENT="1"
DAILY_STOP_LOSS="-3"
