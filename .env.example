# ---------------------------------------------------------------------------
# Neon Postgres — holds tagged_wallets (~24k rows) and coin_stats.
# Use the POOLED connection string; the app talks to Neon over HTTP, so it
# works on serverless where a raw TCP connection to 5432 would not.
#
# Server-side only. Never expose this to the browser.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Helius — RPC + Enhanced Transactions API. The free tier works, but it meters
# by credit, so a deep time-travel rewind on a busy pool will throttle itself
# down and take a while. A paid key is noticeably faster.
# ---------------------------------------------------------------------------
HELIUS_API_KEY="your-helius-api-key"
HELIUS_RPC_URL="https://mainnet.helius-rpc.com"

# Starting request rate for historical scans. The limiter halves this on every
# 429 and recovers on its own, so this is a ceiling, not a promise.
TRACKER_RPS="5"
