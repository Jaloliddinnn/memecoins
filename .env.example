# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or paste real secrets into chat/PR descriptions.

# --- Neon (Serverless Postgres) ---
# Use the pooled connection string ("-pooler" host) for the app at runtime,
# and the direct (non-pooled) string for Prisma migrations if Neon gives you
# a separate one.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# --- Helius ---
# Free tier: 1M credits/mo, 10 requests/sec. Get one at https://dev.helius.xyz
HELIUS_API_KEY="your-helius-api-key"
# Helius mainnet RPC + DAS endpoint (api-key appended by the client at call time)
HELIUS_RPC_URL="https://mainnet.helius-rpc.com"

# --- App ---
# Bounds the historical-mode reconstruction window (minutes) so time-travel
# mode never falls back to scanning thousands of signatures. See
# src/lib/helius/historicalHolders.ts.
HISTORICAL_WINDOW_MINUTES=15
